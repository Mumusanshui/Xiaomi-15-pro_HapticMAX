# HapticMAX — Xiaomi 15 Pro CS40L26A
# 打字不走本模块 RTP/AIHaptic；下列参数服务点击/手势等
persist.vendor.audio.vibrator.aihaptic=1
vendor.aihaptic.interaction.transient_intensity=990
vendor.aihaptic.interaction.transient_sharpness=600
vendor.aihaptic.interaction.continuous_intensity=990
vendor.aihaptic.interaction.continuous_sharpness=600
vendor.aihaptic.warn.transient_intensity=880
vendor.aihaptic.warn.transient_sharpness=400
vendor.aihaptic.warn.continuous_intensity=880
vendor.aihaptic.warn.continuous_sharpness=400
vendor.aihaptic.keyboard.intensity=990
vendor.aihaptic.notification.intensity=850
vendor.aihaptic.ring.intensity=800
vendor.aihaptic.alarm.intensity=800
persist.vendor.haptic.boost_enable=1
persist.vendor.haptic.high_power_mode=1
persist.vendor.haptic.force_max_gain=9.9
persist.vendor.haptic.dynamic_clip_enable=0
persist.vendor.haptic.impedance_auto_adjust=0
persist.vendor.haptic.f0_auto_limit=0
persist.vendor.haptic.auto_amp_limit=0
persist.vendor.haptic.pcm_gain=50.0
persist.vendor.haptic.pcm_max_gain=50.0
persist.mihaptic.force_unlock_max=30
persist.mihaptic.short_pulse_boost=1
persist.mihaptic.long_vib_boost=1
vendor.haptic.calibrate.done=1
vendor.haptic.force_skip_cal=1

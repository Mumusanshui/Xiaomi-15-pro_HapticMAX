#!/sbin/sh
# Magisk/KernelSU Module Installer
umask 022

ui_print() { echo "$1"; }

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

if [ -f /data/adb/magisk/util_functions.sh ]; then
  . /data/adb/magisk/util_functions.sh
elif [ -f /data/adb/ksu/util_functions.sh ]; then
  . /data/adb/ksu/util_functions.sh
else
  ui_print "***********************************"
  ui_print " Please install Magisk v20.4+ or KernelSU "
  ui_print "***********************************"
  exit 1
fi

install_module
exit 0
